<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ product_name }}</title>
<style>
  :root { --bg:#06090F; --fg:#E6F7FF; --muted:#8AA4B8; --cyan:#00F0FF; --line:#00F0FF33; --amber:#FFB800; }
  body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width:760px; margin:0 auto; padding:32px 20px 64px; }
  .banner { border:1px solid var(--amber); color:var(--amber); padding:8px 12px; font:12px/1.4 ui-monospace, monospace; margin-bottom:24px; }
  h1 { margin:0 0 6px; } .tag { color:var(--muted); margin:0 0 20px; }
  .tiers { display:flex; flex-wrap:wrap; gap:12px; margin:20px 0; }
  .tier { flex:1 1 180px; border:1px solid var(--line); padding:14px; }
  .price { font-size:1.6rem; color:var(--cyan); }
  .note { color:var(--muted); font-size:.85rem; }
  .reviews { border:1px dashed var(--line); padding:12px; color:var(--muted); margin:24px 0; }
  form { display:inline; } button { padding:10px 16px; background:var(--cyan); color:#001018; border:0; font-weight:600; cursor:pointer; }
  footer { color:var(--muted); font-size:.8rem; margin-top:40px; }
</style>
</head>
<body><main>
  <div class="banner">PREVIEW on localhost. Payments are MOCKED (in-process test provider; no real or sandbox payments; no card details are ever collected).</div>
  <h1>{{ product_name }}</h1>
  <p class="tag">{{ tagline }}</p>
  <p>{{ description }}</p>
  <h2>What is included</h2>
  <ul>{% for i in includes %}<li>{{ i }}</li>{% endfor %}</ul>
  <p><strong>Who it is for:</strong> {{ who_it_is_for }}</p>
  <p><strong>Who it is not for:</strong> {{ who_it_is_not_for }}</p>
  <h2>Pricing</h2>
  <div class="tiers">
    {% for t in tiers %}<div class="tier"><div>{{ t.name }}</div><div class="price">${{ '%.0f' % t.price }}</div><div class="note">{{ t.what }}</div></div>{% endfor %}
  </div>
  <p class="note">{{ pricing_note }}</p>
  <div class="reviews">No reviews yet</div>
  <form method="post" action="/store/{{ run_id }}/buy"><button type="submit">Simulate test purchase (MOCKED)</button></form>
  <h2>Policies</h2>
  <p class="note">DRAFT - not legal advice; review with a qualified professional. Terms, privacy and refund drafts are in phase4_step2_policies. Refunds are reviewed and approved by the founder.</p>
  <footer>Drafted with ProveIt and approved by the founder before serving.</footer>
</main></body>
</html>
