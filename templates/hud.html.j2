<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ProveIt</title>
<meta name="description" content="Test a digital product idea against real public complaints before you build it. Every quote is checked on its source page, and nothing is published without your approval.">
<meta name="theme-color" content="#EDF0F3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0F1420" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/favicon.svg">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="preload" href="/static/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/fonts/fonts.css">
<link rel="stylesheet" href="/static/console.css?v={{ version }}">
<script>
  // Theme before first paint, so there is no flash of the wrong colours.
  try { const t = localStorage.getItem("proveit_theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
</script>
</head>
<body>
<a class="skip" href="#workspace">Skip to the current idea</a>
<div id="sr-live" class="sr" aria-live="polite" aria-atomic="true"></div>
<div id="sr-alert" class="sr" role="alert" aria-atomic="true"></div>

<div class="shell">
<aside class="sidebar" id="sidebar" aria-label="Your ideas">
  <a class="brand" href="/hud" aria-label="ProveIt home">
    <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#3A35C9"/><path d="M18 33.5l9 9L46 22" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <b>ProveIt</b>
  </a>
  <button class="btn primary newbtn" data-act="new" type="button">Test a new idea <kbd aria-hidden="true">N</kbd></button>
  <nav class="runs" aria-labelledby="runs-h">
    <div class="runs-head"><h2 id="runs-h">Your ideas</h2><button class="linkbtn" id="showall" type="button" hidden>Show all</button></div>
    <div id="runlist"><div class="empty" style="padding:8px 12px">No ideas tested yet.</div></div>
  </nav>
  <div class="sysfoot">
    <div class="sysline"><span class="status-dot" id="modelDot"></span><span id="modelState">AI model: checking…</span></div>
    <div class="sysline"><span class="status-dot ok"></span><span id="voiceState">Voice: checking…</span></div>
    <div class="sysline"><span class="status-dot ok"></span><span>Cost per run: $0.00</span></div>
    <div class="footlinks">
      <button type="button" data-act="privacy">Privacy</button>
      <button type="button" data-act="keys">Shortcuts</button>
      <button type="button" data-act="theme" id="themebtn">Theme: system</button>
    </div>
    <div class="version">ProveIt v{{ version }}{% if commit %} · {{ commit }}{% endif %} · Apache-2.0</div>
  </div>
</aside>

<div class="main">
  <header class="topbar">
    <button class="pill menubtn" type="button" data-act="menu" aria-controls="sidebar" aria-expanded="false">Ideas</button>
    <div class="crumb" id="crumb">Welcome</div>
    <div class="seg" role="group" aria-label="Layout">
      <button type="button" id="m-tactical" data-mode="tactical" aria-pressed="true" title="Tactical writing mode: read and decide">Work<span class="long">space</span></button>
      <button type="button" id="m-hud" data-mode="hud" aria-pressed="false" title="Holographic voice HUD: talk to {{ assistant }}">Voice</button>
      <button type="button" id="m-dual" data-mode="dual" aria-pressed="false" title="Dual-sync: workspace and voice side by side">Both</button>
    </div>
    <button class="pill" id="voiceToggle" type="button" aria-pressed="true" data-act="voice"><span aria-hidden="true">🔊</span><span class="long">Spoken replies</span></button>
  </header>
  <div class="conn" id="conn" role="alert" hidden><b>Lost connection to ProveIt.</b> Your run keeps going on the server; this page reconnects by itself.</div>

  <div class="stage" id="stage">
    <main id="workspace" tabindex="-1">
      <section id="intro" class="intro" aria-labelledby="intro-h" hidden>
        <h1 id="intro-h">Find out if anyone wants it before you build it.</h1>
        <p class="lede">Describe a digital product idea. ProveIt looks for real people describing the problem on public forums, checks every quote on its source page, and tells you plainly when the evidence is too thin to build on.</p>
        <ol class="how">
          <li><b>Describe your idea</b><span>One sentence is enough. Add who it's for if you know.</span></li>
          <li><b>See the evidence</b><span>Real quotes, each linked to where it was said. About a minute.</span></li>
          <li><b>Decide</b><span>Go ahead, look again, try another angle or stop. You stay in charge.</span></li>
        </ol>
        <div class="row">
          <button class="btn primary" type="button" data-act="new">Test a new idea</button>
          <button class="btn quiet" type="button" data-act="latest" id="latestbtn" hidden>Open my latest idea</button>
        </div>
        <div class="promise"><span>No made-up reviews or sign-ups</span><span>Nothing published without your approval</span><span>No income promises</span><span>Free and open source</span></div>
      </section>

      <section id="runview" aria-labelledby="ideaTitle" hidden>
        <div id="banners"></div>
        <div class="idea"><h1 id="ideaTitle" dir="auto"></h1><p id="ideaSub" dir="auto"></p></div>
        <ol class="steps" id="steps" aria-label="Progress through six steps"></ol>
        <p class="steps-compact" id="stepsCompact"></p>
        <div id="verdict"></div>
        <div id="decide"></div>
        <div id="next"></div>
        <div class="later" id="later"></div>
        <div class="tabs" role="tablist" aria-label="Details" id="tabs">
          <button role="tab" id="tab-evidence" aria-controls="pane-evidence" aria-selected="true" tabindex="0">Evidence</button>
          <button role="tab" id="tab-debate" aria-controls="pane-debate" aria-selected="false" tabindex="-1">For and against</button>
          <button role="tab" id="tab-approvals" aria-controls="pane-approvals" aria-selected="false" tabindex="-1">Approvals<span class="count" id="apCount" hidden></span></button>
          <button role="tab" id="tab-files" aria-controls="pane-files" aria-selected="false" tabindex="-1">Files</button>
          <button role="tab" id="tab-status" aria-controls="pane-status" aria-selected="false" tabindex="-1">What's real</button>
        </div>
        <div role="tabpanel" id="pane-evidence" aria-labelledby="tab-evidence" tabindex="0"></div>
        <div role="tabpanel" id="pane-debate" aria-labelledby="tab-debate" tabindex="0" hidden></div>
        <div role="tabpanel" id="pane-approvals" aria-labelledby="tab-approvals" tabindex="0" hidden><div id="approvals"><p class="empty">Nothing is waiting for your approval.</p></div></div>
        <div role="tabpanel" id="pane-files" aria-labelledby="tab-files" tabindex="0" hidden><div class="filelist" id="files"></div><div class="viewer" id="viewer"></div></div>
        <div role="tabpanel" id="pane-status" aria-labelledby="tab-status" tabindex="0" hidden>
          <table class="status">
            <caption>Which steps really run, which are practice (MOCKED) and which are not switched on yet (STUBBED).</caption>
            <thead><tr><th scope="col">Step</th><th scope="col">Status</th></tr></thead>
            <tbody>{% for name, st in status_table %}<tr><td>{{ name }}</td><td><span class="st {{ st }}">{{ st }}</span></td></tr>{% endfor %}</tbody>
          </table>
          <p class="costline" id="costline"></p>
          <button class="btn" type="button" data-act="print">Print the evidence report</button>
        </div>
      </section>
    </main>

    <section class="voice" id="voicepanel" aria-label="Talk to {{ assistant }}" hidden>
      <h2 class="sr">Talk to {{ assistant }}</h2>
      <div class="orbwrap"><canvas id="orb" width="600" height="600" aria-hidden="true"></canvas></div>
      <div class="vstate" id="vstate"><b>{{ assistant }}</b> is ready</div>
      <div class="caption" id="caption" aria-live="polite"></div>
      <div class="vctl">
        <button class="talk" id="ptt" type="button" aria-label="Push to talk: hold, speak, then release">Hold to talk</button>
        <button class="ghost" id="wake" type="button" aria-pressed="false">Say “{{ assistant }}” to start: off</button>
      </div>
      <p class="voicewhy" id="voiceInfo"></p>
      <div class="voice-verdict" id="voiceVerdict" hidden></div>
      <div class="convo" id="convo"></div>
    </section>
  </div>

  <div class="ask">
    <div class="askout" id="askout" role="status" hidden>
      <button class="x" type="button" data-act="closeask" aria-label="Close answer">×</button>
      <div class="who">{{ assistant }}</div>
      <div class="body" id="askbody"></div>
      <div id="askextra"></div>
    </div>
    <form class="askin" role="search" aria-label="Ask {{ assistant }}" id="askform">
      <label class="sr" for="askq">Ask {{ assistant }} about your idea</label>
      <input id="askq" autocomplete="off" maxlength="2000" placeholder="Ask {{ assistant }}: is my idea any good? what should I do next?">
      <kbd aria-hidden="true">Ctrl K</kbd>
      <button class="mic" id="askmic" type="button" aria-pressed="false" aria-label="Speak your question" title="Speak your question">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
      </button>
      <button class="btn primary" type="submit" style="border-radius:999px">Ask</button>
    </form>
  </div>
</div>
</div>

<dialog id="newdlg" aria-labelledby="new-h">
  <form class="dlg" id="newform" novalidate>
    <button class="x" type="button" data-close aria-label="Close">×</button>
    <h2 id="new-h">Test a new idea</h2>
    <p class="lead">Only the idea is required. ProveIt sets the bar for the evidence before it starts searching, so the result can't be bent to fit.</p>
    <div class="examples" aria-label="Examples">
      <button type="button" data-preset="weak"><b>Try an example: weak demand</b>Motivational quote wallpapers</button>
      <button type="button" data-preset="strong"><b>Try an example: real problem</b>Late-payment toolkit for freelancers</button>
    </div>
    <label class="field"><span>Your idea</span>
      <textarea id="f-idea" maxlength="2000" required dir="auto" aria-describedby="idea-hint idea-err" placeholder="A pack of contract templates for freelance wedding photographers"></textarea>
      <small id="idea-hint">A digital product: templates, guides, checklists or a small tool.</small>
      <small id="idea-err" class="formerr" hidden>Describe your idea in a sentence first.</small>
    </label>
    <details class="more"><summary>Add more about you (optional)</summary>
      <div class="two">
        <label class="field"><span>Who it's for, or where</span><input id="f-target_market" maxlength="300" dir="auto"></label>
        <label class="field"><span>Your skills</span><input id="f-skills" maxlength="300" dir="auto"></label>
        <label class="field"><span>Budget</span><input id="f-budget" maxlength="100"></label>
        <label class="field"><span>Hours per week</span><input id="f-hours_per_week" maxlength="50" inputmode="numeric"></label>
      </div>
      <label class="field"><span>What matters to you</span><input id="f-values" maxlength="300" dir="auto"></label>
      <label class="field"><span>Paste a whole brief</span><textarea id="paste" dir="auto"></textarea><small>Lines like “Idea: …” or “Budget: …” are read into the fields.</small></label>
      <button type="button" class="btn" data-act="parse">Read it into the fields</button>
      <label class="field" style="margin-top:12px"><span>How deep to look</span>
        <select id="runmode"><option value="live">One angle (about a minute)</option><option value="full">Three angles (a few minutes)</option></select></label>
    </details>
    <div class="dlgfoot">
      <small>Your idea is sent to NVIDIA's hosted AI model, and searches go to public forums. Free.</small>
      <div style="display:flex;gap:8px"><button type="button" class="btn" data-close>Cancel</button><button type="submit" class="btn primary" id="startbtn">Start</button></div>
    </div>
  </form>
</dialog>

<dialog id="privacydlg" aria-labelledby="priv-h">
  <div class="dlg prose">
    <button class="x" type="button" data-close aria-label="Close">×</button>
    <h2 id="priv-h">Where your information goes</h2>
    <ul>
      <li><b>Your idea and your questions</b> are sent to NVIDIA's hosted AI model (build.nvidia.com) to write search queries and answers.</li>
      <li><b>Searches</b> derived from your idea go to Hacker News, Stack Exchange, GitHub and Wikipedia. Don't put confidential details in an idea.</li>
      <li><b>Runs, quotes and decisions</b> are stored on this computer (the <code>runs/</code> and <code>data/</code> folders), not in any cloud.</li>
      <li><b>Spoken replies</b> use Piper, which runs on this computer. If it isn't installed, your browser's own voice is used.</li>
      <li><b>Speaking to {{ assistant }}</b> uses your browser's speech recognition; in Chrome and Edge that sends the audio to Google or Microsoft. Typing never leaves this computer except as a question to the AI model.</li>
      <li>No analytics, no tracking, no cookies. Fonts are served from this computer.</li>
    </ul>
    <div class="dlgfoot"><span></span><button class="btn primary" type="button" data-close>Done</button></div>
  </div>
</dialog>

<dialog id="keysdlg" aria-labelledby="keys-h">
  <div class="dlg">
    <button class="x" type="button" data-close aria-label="Close">×</button>
    <h2 id="keys-h">Keyboard shortcuts</h2>
    <div class="keys">
      <span><kbd>Ctrl</kbd> <kbd>K</kbd> or <kbd>/</kbd></span><span>Ask {{ assistant }}</span>
      <span><kbd>N</kbd></span><span>Test a new idea</span>
      <span><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></span><span>Workspace, voice, or both</span>
      <span><kbd>←</kbd> <kbd>→</kbd></span><span>Move between tabs (when a tab is focused)</span>
      <span><kbd>Esc</kbd></span><span>Close a dialog or the answer card</span>
      <span><kbd>?</kbd></span><span>Show this list</span>
    </div>
    <div class="dlgfoot"><span></span><button class="btn primary" type="button" data-close>Done</button></div>
  </div>
</dialog>

<script>
  window.PROVEIT = {
    api: {{ api_base|tojson }} || "",
    embed: {{ 'true' if embed else 'false' }},
    demo: {{ 'true' if demo else 'false' }},
    mode: {{ initial_mode|tojson }},
    assistant: {{ assistant|tojson }},
    version: {{ version|tojson }},
    model: {{ model|tojson }}
  };
</script>
<script src="/static/console.js?v={{ version }}" defer></script>
</body>
</html>
