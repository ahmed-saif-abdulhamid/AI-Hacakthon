# Copy to .env and set NVIDIA_API_KEY. Placeholders only; never commit real keys.

# Model: open-weight NVIDIA Nemotron hosted on NVIDIA build (free developer tier, ~40 requests/min).
# Get a free key at https://build.nvidia.com (any model page -> Get API Key). Briefs and evidence
# are sent to NVIDIA. Placeholder only: put your real key in .env, which is gitignored.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT=120

# Self-hosted metasearch (container)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-random-string

# Storage and signing
PROVEIT_DB=/app/data/proveit.db
SECRET_KEY=change-me-to-a-random-string

# Optional free keys: they only raise public rate limits
GITHUB_TOKEN=
SE_KEY=

# Console
API_PUBLIC_URL=http://localhost:8000
JARVIS_ADDRESS=Sir
# Local voice (optional): path to a Piper voice file; browser speech is the fallback
PIPER_VOICE=en_GB-alan-medium
WHISPER_MODEL=tiny.en

# Container user (Linux hosts whose uid is not 1000)
UID=1000
GID=1000
