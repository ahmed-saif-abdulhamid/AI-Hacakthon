# Copy to .env only if you need to change something. Placeholders only; no key is required.

# Open-weight model served by Ollama (exact tag used everywhere)
MODEL=qwen3:4b-instruct-2507-q4_K_M
# Default: the ollama container. For GPU/Metal use the host's native Ollama:
#   SKIP_PULL=1 LLM_BASE_URL=http://host.docker.internal:11434 docker compose up
LLM_BASE_URL=http://ollama:11434
SKIP_PULL=0
LLM_TIMEOUT=240

# Self-hosted metasearch (container)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-random-string

# Storage and signing
PROVEIT_DB=/app/data/proveit.db
SECRET_KEY=change-me-to-a-random-string

# Optional free keys: they only raise public rate limits
GITHUB_TOKEN=
SE_KEY=

# Console
API_PUBLIC_URL=http://localhost:8000
JARVIS_ADDRESS=Sir
# Local voice (optional): path to a Piper voice file; browser speech is the fallback
PIPER_VOICE=en_GB-alan-medium
WHISPER_MODEL=tiny.en

# Container user (Linux hosts whose uid is not 1000)
UID=1000
GID=1000
