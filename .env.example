# Copy to .env only to change a default. Placeholders only; never commit real keys.

# Model provider: "ollama" (local open-weight model, no key; the default with docker compose) or
# "nvidia" (open-weight NVIDIA Nemotron on NVIDIA build's free developer tier, ~40 requests/min).
# Unset: an NVIDIA key selects nvidia, otherwise ollama.
LLM_PROVIDER=ollama
# Local model served by Ollama (docker compose downloads it on first start)
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_URL=http://localhost:11434

# Hosted alternative: a free key from https://build.nvidia.com (any model page -> Get API Key).
# Briefs and evidence are then sent to NVIDIA. Put a real key only in .env, which is gitignored.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Seconds per model call (a local model on a CPU needs more)
LLM_TIMEOUT=600
# Requests per minute ProveIt allows itself (the free tier allows about 40 for the whole account)
LLM_RPM=30
# Any OpenAI-compatible server works here, including a self-hosted one
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Self-hosted metasearch. docker compose sets SEARXNG_URL itself; outside Docker leave it unset unless
# you run SearXNG (then for example http://localhost:8080).
# SEARXNG_URL=
SEARXNG_SECRET=change-me-to-a-random-string

# Storage and signing. docker compose sets the database path; outside Docker the default is data/proveit.db.
# PROVEIT_DB=
SECRET_KEY=change-me-to-a-random-string

# Optional free keys: they only raise public rate limits
GITHUB_TOKEN=
SE_KEY=

# Console
API_PUBLIC_URL=http://localhost:8000
# The assistant's name on screen, the word you say to call it, and how it addresses you (optional,
# for example your first name or Sir)
ASSISTANT_NAME=J.A.R.V.I.S.
WAKE_WORD=Jarvis
FOUNDER_NAME=
# Local voice (optional): path to a Piper voice file; browser speech is the fallback
PIPER_VOICE=en_GB-alan-medium
WHISPER_MODEL=tiny.en

